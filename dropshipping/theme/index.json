      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I pick my size?",
            "icon": "ruler",
            "row_content": "<p>They come in paired EU sizes (36-37 up to 44-45). Check the size guide in the product photos. Between sizes or wider feet? Size up.</p>",
            "page": ""
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are they unisex?",
            "icon": "heart",
            "row_content": "<p>Yes. The same slide fits all feet. Use the US Women / US Men columns in the size guide.</p>",
            "page": ""
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I wear them outside?",
            "icon": "leaf",
            "row_content": "<p>They're made for home and patio: bedroom, couch, fireplace and a quick step out to the porch. Not for walks, mud, wet ground or snow.</p>",
            "page": ""
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "icon": "truck",
            "row_content": "<p>Orders ship in 1-3 business days and usually arrive in 5-11 business days in the US. Shipping is free and you get tracking by email.</p>",
            "page": ""
          }
        },
        "q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I wash them?",
            "icon": "washing",
            "row_content": "<p>Spot clean or gently hand wash in cool water, then air dry away from heat. Don't tumble dry.</p>",
            "page": ""
          }
        },
        "q6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if they don't fit?",
            "icon": "return",
            "row_content": "<p>You have 30 days from delivery to ask for a return or a size exchange. Just email us.</p>",
            "page": ""
          }
        }
