# ============================================================================
# Videora AI — environment variables
# Copy this file to .env for local development (`cp .env.example .env`).
# Never commit your real .env file.
# ============================================================================

# --- Core ------------------------------------------------------------------

# SQLite by default (zero setup). For production, use a Postgres URL, e.g.
#   DATABASE_URL="postgresql://user:password@host:5432/videora"
# and change `provider = "sqlite"` to `provider = "postgresql"` in
# prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Public base URL of this deployment (used for links in emails, Stripe
# redirects, NextAuth, etc).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign auth sessions/JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# When true, the app never calls real AI/video/voice APIs, even if keys are
# set below — every provider falls back to its Mock implementation and the
# full product flow (script, storyboard, generation, editor, export) works
# with simulated data. Set to "false" once you've configured real API keys
# and want to go live.
DEMO_MODE="true"

# --- Google OAuth (optional) -------------------------------------------------
# Leave empty to disable "Continue with Google" — email/password still works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI script generation ---------------------------------------------------
# Any OpenAI-compatible chat completions API (OpenAI, Azure OpenAI, a local
# model server, etc). Leave AI_API_KEY empty to use the built-in deterministic
# mock script writer.
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_API_URL="https://api.openai.com/v1/chat/completions"

# --- Video generation --------------------------------------------------------
# Text/image-to-video provider (Runway, Luma, Pika, Kling, etc). Leave empty
# to use the built-in Mock video provider (local demo clips + simulated
# progress). See lib/providers/video/real.ts for the expected REST shape.
VIDEO_API_KEY=""
VIDEO_API_URL=""

# --- Voice / text-to-speech --------------------------------------------------
# Leave empty to use the built-in Mock voice provider.
VOICE_API_KEY=""
VOICE_API_URL=""

# --- Storage (product photo / logo uploads) ---------------------------------
# Leave empty to store uploads on local disk under /public/uploads (fine for
# development; NOT durable on most serverless hosts). Configure an
# S3-compatible bucket or Supabase Storage for production.
STORAGE_URL=""
STORAGE_KEY=""

# --- Stripe (subscriptions) --------------------------------------------------
# Leave empty to keep billing in "demo upgrade" mode (plan/credits UI works,
# no real charge happens). See lib/stripe.ts and app/api/stripe/*.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_CREATOR=""
STRIPE_PRICE_ID_PRO=""
